# Copy to .env and adjust. All values are optional.
OLLAMA_HOST=http://127.0.0.1:11434
OCA_CHAT_MODEL=qwen2.5-coder:7b
OCA_EMBED_MODEL=nomic-embed-text
# Context window passed to Ollama (num_ctx). Ollama's default is small; agents need more.
OCA_NUM_CTX=16384
OCA_TEMPERATURE=0.2
# Where LanceDB indexes are stored (one sub-folder per indexed repo).
OCA_DATA_DIR=~/.offline-code-assistant
# Retrieval / agent tuning
OCA_TOP_K=8
OCA_MAX_AGENT_STEPS=12
